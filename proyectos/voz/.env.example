# ---- Supabase ----
# Pooler en modo transaccion (IPv4, funciona en cualquier VPS).
# Saca el host exacto en: Dashboard > Project Settings > Database > Connection pooling
PG_DSN=postgresql://postgres.wnfhayjkgllmrgdkyvou:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://wnfhayjkgllmrgdkyvou.supabase.co
SUPABASE_JWT_SECRET=        # Project Settings > API > JWT Secret
SUPABASE_SERVICE_KEY=          # service_role. NUNCA lo subas al repo ni al front

# ---- LiveKit ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Modelos ----
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

CARTESIA_VOICE_ID=5c5ad5e7-1020-476b-8b91-fdcbe9cc313c
LLM_PROVEEDOR=openai        # openai | anthropic
LLM_MODEL=gpt-4.1-mini

# ---- Opcional ----
N8N_WEBHOOK=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ---------- Instagram Direct y Messenger ----------
# Comparten webhook y API de envio, pero cada producto tiene su propio token.
SOCIAL_VERIFY_TOKEN=
SOCIAL_APP_SECRET=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=
SOCIAL_MESSENGER_ACCESS_TOKEN=
# Solo para desarrollo: acepta webhooks sin firma.
SOCIAL_PERMITIR_SIN_FIRMA=false

# ---- ElevenLabs (TTS por defecto) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=MOpELGWw8bqcERsmVMzW
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- STT ----
# Flux (deteccion de turno integrada) SOLO existe en ingles a agosto 2026.
# Para espanol: nova-3 + el detector de turno semantico de LiveKit.
STT_MODEL=nova-3
STT_LANGUAGE=es-MX

# ---- TTS por defecto ----
# deepgram (mas barato, ya usas su STT) | elevenlabs | cartesia
DEEPGRAM_VOZ=aura-2-javier-es

# ---- Azure Speech (TTS mas economico) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOZ=es-MX-DaliaNeural

# ---------- Canales de texto: LLM y versión de Graph ----------
TEXTO_LLM_PROVEEDOR=openai       # cerebro de WhatsApp/IG/Messenger
TEXTO_LLM_MODELO=gpt-4.1-mini
WHATSAPP_API_VERSION=v25.0       # los tokens nuevos exigen v25+
WHATSAPP_GRAPH_URL=https://graph.facebook.com
SOCIAL_API_VERSION=v25.0
LLM_MAX_TOKENS=1024
LLM_MAX_ITERACIONES=6

# ---------- Campañas por llamada saliente (despachador) ----------
LIVEKIT_SIP_TRUNK_SALIENTE=ST_...   # troncal de salida de LiveKit; sin él, las campañas por llamada quedan en cola con error
TELEFONO_SALIDA=+52...               # número que ve quien recibe la llamada
