<?xml version="1.0" encoding="UTF-8"?>
<!-- Escritorio del agente: una sola ventana, sin marco ni botones (no se puede
     minimizar ni mover), siempre maximizada. El dueño ve la página, no un escritorio. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <theme><keepBorder>no</keepBorder></theme>
  <desktops><number>1</number></desktops>
  <keyboard/>
  <mouse/>
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
