# Se mueve a apps/prod.yaml en el corte (runbook corte-a-aws.md): antes, el worker de voz sin nombre
# tomaría llamadas reales contra una base vacía.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: prod
  namespace: argocd
spec:
  project: default
  source:
    repoURL: git@github.com:LoGebo/dimia.git
    targetRevision: main
    path: despliegues/apps/prod-c01
  destination: { name: c01-mx, namespace: prod }
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true]
    retry: { limit: 10, backoff: { duration: 30s, factor: 2, maxDuration: 5m } }
