{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MCPSoloConAgenteLectura",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "Bool": { "aws:ViaAWSMCPService": "true" },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*AWSReservedSSO_agente-lectura_*"
        }
      }
    }
  ]
}
